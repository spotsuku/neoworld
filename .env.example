# すべてサーバー側のみで使用。クライアントには一切渡らない。
# ローカル開発: `vercel dev` 実行時に .env / Vercel環境変数から読み込まれる
# デプロイ: Vercelダッシュボードの Environment Variables に設定

# AI生成(年代記・インタビュー・観測レポート)に必要
ANTHROPIC_API_KEY=

# シミュレーション記録の保存(💾保存/📂記録)に必要
# Supabaseダッシュボード → Settings → API から取得。
# 事前に supabase/schema.sql をSQL Editorで実行しておくこと。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
